{
  "sdkVersion": 2,
  "id": "nextchat.claude-code",
  "version": "4.0.0",
  "name": "Claude Code",
  "description": {
    "cn": "使用桌面内置 Claude Code CLI 或自行部署的 Node 桥接服务。",
    "en": "Use the built-in desktop CLI or a self-hosted Node bridge."
  },
  "protocols": ["anthropic"],
  "capabilities": ["request", "driver"],
  "fields": {
    "connection": {
      "title": {
        "cn": "连接方式",
        "en": "Connection"
      },
      "type": "select",
      "default": "builtin",
      "options": [
        {
          "value": "builtin",
          "label": {
            "cn": "内置（桌面）",
            "en": "Built-in (desktop)"
          }
        },
        {
          "value": "external",
          "label": {
            "cn": "外部桥接服务",
            "en": "External bridge"
          }
        }
      ]
    },
    "authType": {
      "title": {
        "cn": "网关认证",
        "en": "Gateway authentication"
      },
      "type": "select",
      "default": "api-key",
      "options": [
        {
          "value": "api-key",
          "label": "x-api-key"
        },
        {
          "value": "bearer",
          "label": "Bearer token"
        }
      ]
    },
    "bridgeUrl": {
      "title": {
        "cn": "桥接服务地址",
        "en": "Bridge URL"
      },
      "type": "string",
      "default": "http://127.0.0.1:8788",
      "when": {
        "field": "connection",
        "value": "external"
      }
    },
    "bridgeToken": {
      "title": {
        "cn": "桥接服务令牌",
        "en": "Bridge token"
      },
      "type": "secret",
      "when": {
        "field": "connection",
        "value": "external"
      }
    },
    "nativeCliVersion": {
      "title": {
        "cn": "外部桥接 CLI 版本",
        "en": "External CLI version"
      },
      "description": {
        "cn": "外部桥接要求精确版本。",
        "en": "External bridges require an exact version."
      },
      "type": "string",
      "default": "2.1.322",
      "when": {
        "field": "connection",
        "value": "external"
      }
    },
    "nativeBeta": {
      "title": {
        "cn": "CLI Beta 标记",
        "en": "CLI beta flags"
      },
      "description": {
        "cn": "留空使用 CLI 默认值。",
        "en": "Leave empty to use CLI defaults."
      },
      "type": "string"
    },
    "nativeEffort": {
      "title": {
        "cn": "CLI 思考强度",
        "en": "CLI reasoning effort"
      },
      "description": {
        "cn": "留空沿用对话设置。",
        "en": "Leave empty to use the chat setting."
      },
      "type": "string"
    }
  }
}
